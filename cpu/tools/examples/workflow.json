{
  "schema": 1,
  "binary": "/ABS/clean-build/openmx-cpu",
  "build_manifest": "/ABS/clean-build/build-manifest.json",
  "inputs": {
    "nsoc": "/ABS/case/nsoc.dat",
    "soc": "/ABS/case/soc.dat"
  },
  "output": "/ABS/results-new",
  "layout": {
    "hosts": [
      "node040",
      "node041"
    ],
    "ranks_per_host": 2,
    "threads": 1,
    "cpu_ids_per_host": {
      "node040": [
        0,
        1
      ],
      "node041": [
        0,
        1
      ]
    }
  },
  "runtime": {
    "mpiexec": "/opt/intel/oneapi/mpi/2021.7.1/bin/mpirun",
    "runtime_prefix": "/opt/intel/oneapi",
    "environment_prefix": "/path/to/python-env",
    "transport": "shm:ofi"
  },
  "profiles": {
    "nsoc": {
      "name": "explicit-raw-control",
      "environment": {}
    },
    "soc": {
      "name": "explicit-raw-control",
      "environment": {}
    }
  },
  "symmetry": {
    "project": false,
    "compact": false,
    "soc_export_policy": "raw"
  },
  "monitor_interval_seconds": 0.25,
  "timeout_seconds": null
}
